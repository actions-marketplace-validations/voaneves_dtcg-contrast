{
  "ref": {
    "color": {
      "$type": "color",
      "ink": {
        "900": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.102, 0.102], "hex": "#1a1a1a" } },
        "925": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.0784, 0.0784], "hex": "#141414" } },
        "950": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "hex": "#0a0a0a" } }
      },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "cream": {
        "100": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9176, 0.8314], "hex": "#f4ead4" } },
        "200": { "$value": { "colorSpace": "srgb", "components": [0.9373, 0.8941, 0.7725], "hex": "#efe4c5" } },
        "300": { "$value": { "colorSpace": "srgb", "components": [0.9098, 0.8706, 0.7725], "hex": "#e8dec5" } }
      },
      "sand": {
        "500": { "$value": { "colorSpace": "srgb", "components": [0.651, 0.6118, 0.5255], "hex": "#a69c86" } },
        "600": { "$value": { "colorSpace": "srgb", "components": [0.5412, 0.5059, 0.4392], "hex": "#8a8170" } },
        "700": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.4392, 0.3608], "hex": "#7a705c" } },
        "800": { "$value": { "colorSpace": "srgb", "components": [0.3608, 0.3294, 0.2745], "hex": "#5c5446" } }
      },
      "red": {
        "400": { "$value": { "colorSpace": "srgb", "components": [1, 0.3529, 0.3529], "hex": "#ff5a5a" } },
        "450": { "$value": { "colorSpace": "srgb", "components": [1, 0.2196, 0.2196], "hex": "#ff3838" } },
        "600": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0, 0], "hex": "#f50000" } },
        "800": { "$value": { "colorSpace": "srgb", "components": [0.7216, 0, 0], "hex": "#b80000" } }
      }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{ref.color.cream.100}",
      "$extensions": { "vn": { "dark": "{ref.color.ink.950}" } }
    },
    "surface-soft": {
      "$value": "{ref.color.cream.200}",
      "$extensions": { "vn": { "dark": "{ref.color.ink.925}" } }
    },
    "surface-raised": {
      "$value": "{ref.color.white}",
      "$extensions": { "vn": { "dark": "{ref.color.ink.900}" } }
    },
    "surface-signal": {
      "$value": "{ref.color.red.600}",
      "$extensions": { "vn": { "dark": "{ref.color.red.450}" } }
    },
    "text": {
      "$value": "{ref.color.ink.950}",
      "$extensions": { "vn": { "dark": "{ref.color.cream.300}" } }
    },
    "text-muted": {
      "$value": "{ref.color.sand.800}",
      "$extensions": { "vn": { "dark": "{ref.color.sand.500}" } }
    },
    "text-on-signal": {
      "$value": "{ref.color.ink.950}",
      "$extensions": { "vn": { "dark": "{ref.color.ink.950}" } }
    },
    "signal": {
      "$value": "{ref.color.red.600}",
      "$extensions": { "vn": { "dark": "{ref.color.red.450}" } }
    },
    "signal-ink": {
      "$value": "{ref.color.red.800}",
      "$extensions": { "vn": { "dark": "{ref.color.red.400}" } }
    },
    "line-strong": {
      "$value": "{ref.color.sand.700}",
      "$extensions": { "vn": { "dark": "{ref.color.sand.600}" } }
    }
  }
}
