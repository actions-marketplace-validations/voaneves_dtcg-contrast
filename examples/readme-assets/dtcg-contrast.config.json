    { "fg": "button.primary.fill", "bg": "page", "level": "UI" },
    { "fg": "logo.paper", "bg": "logo.ink", "level": "UI" },
    { "fg": "logo.signal", "bg": "logo.paper", "level": "UI" },
    { "fg": "logo.signal", "bg": "logo.ink", "level": "UI" },
    { "fg": "logo.ring", "bg": "page", "level": "UI" }
