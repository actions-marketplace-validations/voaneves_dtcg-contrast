{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Colors of the README logo and CTA buttons. Gated in CI by dtcg-contrast and read by scripts/readme-assets.py.",
  "page": {
    "$type": "color",
    "$description": "GitHub page background.",
    "$value": "#ffffff",
    "$extensions": { "vn": { "dark": "#0d1117" } }
  },
  "button": {
    "$type": "color",
    "primary": {
      "fill": { "$value": "#0a0a0a", "$extensions": { "vn": { "dark": "#e8dec5" } } },
      "text": { "$value": "#f4ead4", "$extensions": { "vn": { "dark": "#0a0a0a" } } },
      "signal": { "$value": "#ff3838", "$extensions": { "vn": { "dark": "#b80000" } } }
    },
    "secondary": {
      "fill": { "$value": "#f4ead4", "$extensions": { "vn": { "dark": "#1c1a17" } } },
      "text": { "$value": "#0a0a0a", "$extensions": { "vn": { "dark": "#e8dec5" } } },
      "border": { "$value": "#0a0a0a", "$extensions": { "vn": { "dark": "#8a816f" } } }
    },
    "command": {
      "prompt": { "$value": "#b80000", "$extensions": { "vn": { "dark": "#ff5a5a" } } }
    }
  },
  "logo": {
    "$type": "color",
    "ink": { "$value": "#0a0a0a" },
    "paper": { "$value": "#f4ead4" },
    "ring": { "$value": "#0a0a0a", "$extensions": { "vn": { "dark": "#e8dec5" } } },
    "signal": { "$value": "#d70000" }
  }
}
